---
/**
 * Homepage — a 1:1 reproduction of Figma `6Lgtxs8zSUzruc8zu8tY0T` frame `32:84`
 * (Homepage, 1440 x 8341) at >=90rem. Below 90rem the design does not exist, so
 * that layout is authored by us and is called out as such in each component.
 *
 * The eight sections map to the eight child frames of `32:84`, in order:
 *   1:2 Hero · 7:26 The Problem · 8:27 Services · 8:28 Proof
 *   8:29 Process · 8:30 Differentiator · 8:31 About Strip · 8:32 CTA
 *
 * The footer drawn inside 8:32 is an older variant; BaseLayout's shared Footer
 * renders instead.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'

import HomeHero from '@/components/HomeHero.astro'
import HomeProblem from '@/components/HomeProblem.astro'
import HomeServices from '@/components/HomeServices.astro'
import HomeProof from '@/components/HomeProof.astro'
import HomeProcess from '@/components/HomeProcess.astro'
import HomeDifferentiator from '@/components/HomeDifferentiator.astro'
import HomeAboutStrip from '@/components/HomeAboutStrip.astro'
import HomeClosing from '@/components/HomeClosing.astro'

import { META } from '@/content/site'
---

{
  /**
   * AUTHORED 2026-08-18 — the shared footer is off the homepage. Requested
   * twice: first as "remove the Footer for the Homepage", then as "remove the
   * 'Creative systems and 3D production for teams that need more content.'
   * section completely". The closing frame (8:32) carries its own footer in
   * the design, so a shared footer under it was a second one.
   *
   * ⚠ This was briefly CONDITIONAL on `NEWSLETTER_ENDPOINT`, so that the page
   * could not end on an empty panel before the newsletter could render. Gerald
   * asked for the removal again with the endpoint still unset, so the condition
   * is gone and the consequence is accepted:
   *
   *   Until `NEWSLETTER_ENDPOINT` is set, THIS PAGE HAS NO FOOTER AT ALL. It
   *   ends on the 24:230 panel, which is empty — exactly the state the 1:1
   *   rebuild shipped, since the design's own footer variant in that half was
   *   never reproduced.
   *
   *   The homepage therefore carries no Services / Explore / Find me columns
   *   (33:734 / 33:739 / 33:744, which hold the only LinkedIn, ArtStation,
   *   Behance and GitHub links on the site) and no copyright line (33:757).
   *   Nothing else renders them. Setting the endpoint fills the panel with the
   *   newsletter but does NOT bring the links or the copyright back.
   *
   * Pass no `footer` prop at all to restore it.
   */
}
<BaseLayout title={META.home.title} description={META.home.description} footer={false}>
  <div class="home">
    <HomeHero />
    <HomeProblem />
    <HomeServices />
    <HomeProof />
    <HomeProcess />
    <HomeDifferentiator />
    <HomeAboutStrip />
    <HomeClosing />
  </div>
</BaseLayout>

<style>
  /**
   * Nine of the Figma's font sizes on this page have no `--text-fx-*` token in
   * global.css, so they are declared here instead of editing the shared layer.
   * Each is built to the same ramp shape as the shared ones — exactly the Figma
   * value at a 1440px viewport, falling to an authored minimum at 390px — and
   * each carries the node it was measured from.
   *
   * Custom properties inherit, so every `Home*` component reads these without
   * importing anything.
   */
  .home {
    /**
     * Leading. Figma takes the STATIC Roboto Condensed hhea ratio 2400/2048 and
     * rounds to a whole pixel PER SIZE — see the rule in AGENTS.md. So each of
     * the sizes above pairs with an exact leading, and at >=90rem the components
     * use `--leading-fx-*` from global.css wherever the size has a shared token.
     * The six below are the homepage-only sizes, same rule, node ids attached.
     *
     * ⚠ These are px-derived and correct ONLY at the design size. Below 90rem
     * the `--home-text-*` and `--text-fx-*` sizes clamp down, so the components
     * fall back to the unitless `--leading-fx` there. Never promote one of these
     * out of the `@media (min-width: 90rem)` block.
     *
     * ⚠ Do not "simplify" these to a single ratio. This page carried a flat
     * 1.171875 and then a flat 7/6, and both looked right against the nodes that
     * happened to get sampled: at 18/24/30/36 the rounded value IS 7/6 exactly,
     * so body copy proves 7/6 and headings disprove it. Across the ten clean
     * nodes on this frame the per-size rule is exact on all ten; 7/6 is exact on
     * four and runs 0.67px per line short at 38, 62 and 64px. A node whose height
     * divides evenly under both is not evidence.
     *
     * ⚠ Before treating any node as evidence about leading, check it is Auto,
     * single-face, and has no explicit height. All three confounds are on this
     * page: 22:36 is a typed 68px override in a 62px box, 24:199 is a fixed box
     * smaller than its own text, and 4:6 is mixed-face (see below).
     */
    --home-leading-12: 0.875rem; /* 14px — 12px, node 22:43 */
    /* --home-leading-13 / --home-text-13 (16px / 13.792px, node 22:72) were
       deleted 2026-08-18. Their only consumer was `.proof__eyebrow`, which now
       takes `--text-fx-18` to match `.problem__eyebrow` — see the AUTHORED note
       in HomeProof.astro. Restore both from 22:72 if that ever reverts. */
    /**
     * 25px — 21.278px, node 4:6. Its rendered block is 125px against a 124px
     * Figma box, and that 1px is NOT the rule failing: 4:6 is a mixed-face node.
     * Its root is Poppins Regular with `leading-[0]`, every text run inside it is
     * Roboto Condensed, and it contains a hard `<br>` — so neither the line count
     * nor which face sets each line box is determined, and the node cannot
     * discriminate between leading models. 25px is right for the runs that
     * actually render. ⚠ Do not copy the root's face onto this block; the whole
     * hero lede would become Poppins.
     */
    --home-leading-21: 1.5625rem;
    --home-leading-23: 1.6875rem; /* 27px — 23.045px, the opener run in 24:199 */
    --home-leading-30b: 2.25rem; /* 36px — 30.34px, node 22:62 */
    --home-leading-36: 2.6875rem; /* 43px — 36.78px, nodes 22:76, 22:85, 23:181 */

    --home-text-17: clamp(1rem, 0.970194rem + 0.12229vw, 1.08025rem); /* 17.284px — 24:199, 24:203 */
    --home-text-21: clamp(1.0625rem, 0.963188rem + 0.40743vw, 1.329875rem); /* 21.278px — 4:6 */
    --home-text-30b: clamp(1.25rem, 1.009963rem + 0.98476vw, 1.89625rem); /* 30.34px — 22:62 */
    --home-text-36: clamp(1.375rem, 1.0319rem + 1.4076vw, 2.29875rem); /* 36.78px — 22:76, 22:85, 23:181 */

    /* Three sizes the design keeps small and flat. Below 90rem they are raised
       to an authored 0.75rem floor by the components that use them. */
    --home-text-12: 0.75rem; /* 12px — 22:43 */
    --home-text-11a: 0.6896rem; /* 11.033px — 22:46, 33:812, 33:816 */
    --home-text-11b: 0.6928rem; /* 11.085px — 24:192 */
  }

  /**
   * No nav compensation here, deliberately.
   *
   * In the Figma the navbar is a child of the first section frame at y=0
   * (`33:611` inside Hero `1:2`), so it costs the page no height and section one
   * starts at page y=0. The shared `Nav` is `position: absolute` and out of
   * flow, which already gives exactly that. If it ever returns to normal flow,
   * every y on this page goes 85px out and the fix belongs in `Nav`, not here.
   */
</style>
