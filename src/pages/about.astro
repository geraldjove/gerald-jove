---
import { Image } from 'astro:assets'

import BaseLayout from '@/layouts/BaseLayout.astro'
import CtaBlock from '@/components/CtaBlock.astro'

import { META } from '@/content/site'
import { ABOUT } from '@/content/about'
import { blankValue } from '@/content/blanks.js'

import profilePhoto from '@/assets/img/profile-photo.jpg'

/** Blank #5 — the human close. Section omitted entirely until it is written. */
const humanClose = blankValue(ABOUT.humanCloseBlank as never)
---

<BaseLayout title={META.about.title} description={META.about.description}>
  <section class="shell grid items-start gap-10 py-section lg:grid-cols-[1fr_15rem] lg:gap-16">
    <div>
      <h1 class="text-h1 text-fg">{ABOUT.h1}</h1>
      <p class="measure mt-5 text-lead text-fg-muted">{ABOUT.subheadline}</p>
    </div>

    <Image
      src={profilePhoto}
      alt="Gerald Jove"
      widths={[240, 480]}
      sizes="(min-width: 1024px) 240px, 160px"
      format="avif"
      class="order-first w-40 rounded-lg border border-line object-cover lg:order-none lg:w-full"
    />
  </section>

  <section class="border-t border-line bg-raised">
    <div class="shell grid gap-8 py-section md:grid-cols-[7rem_1fr]">
      <p class="eyebrow reveal">01 — Story</p>
      <div class="reveal measure">
        <h2 class="text-h2 text-fg">{ABOUT.story.heading}</h2>
        <div class="mt-6 space-y-5">
          {ABOUT.story.body.map((para) => <p class="text-body text-fg-muted">{para}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="shell grid gap-8 py-section md:grid-cols-[7rem_1fr]">
      <p class="eyebrow reveal">02 — Capability</p>
      <div class="reveal">
        <h2 class="text-h2 text-fg">{ABOUT.capabilities.heading}</h2>

        <dl class="mt-8 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-3">
          {
            ABOUT.capabilities.groups.map((group) => (
              <div class="bg-ink p-6">
                <dt class="text-h3 text-fg">{group.label}</dt>
                <dd class="mt-3 text-small text-fg-subtle">{group.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-raised">
    <div class="shell grid gap-8 py-section-sm md:grid-cols-[7rem_1fr]">
      <p class="eyebrow reveal">03 — Credentials</p>
      <div class="reveal measure">
        <h2 class="text-h3 text-fg">{ABOUT.credentials.heading}</h2>
        <p class="mt-3 text-body text-fg-muted">{ABOUT.credentials.body}</p>
      </div>
    </div>
  </section>

  {
    humanClose && (
      <section class="border-t border-line">
        <div class="shell py-section-sm">
          <p class="measure reveal text-lead text-fg-muted">{humanClose}</p>
        </div>
      </section>
    )
  }

  <CtaBlock heading="Let’s find out where your bottleneck actually is." />
</BaseLayout>
