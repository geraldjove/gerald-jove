---
/**
 * /services — built from Figma `6Lgtxs8zSUzruc8zu8tY0T`, frame `33:504`.
 * Four sections, then the shared Footer.
 *
 *   33:285  Services Section              ServiceIntro
 *   33:293  Creative Automation Systems   ServiceDetail
 *   33:431  Managed Ad Creative           ServiceDetail
 *   33:447  3D Product Visuals & CGI Ads  ServiceDetail
 *   33:700  Footer                        the shared Footer, not this frame
 *
 * ⚠ The Figma draws each detail as one tall frame (2069 / 2069 / 2316px) with
 * every block pinned at its own y. Since 2026-08-18 each is ONE 100svh row with
 * the blocks flowing into two balanced columns beside the rail, so those
 * per-node y coordinates no longer describe anything and were removed rather
 * than left here looking authoritative. They are in git history if a 1:1
 * restoration is ever wanted. Full reasoning: `ServiceDetail.astro`.
 *
 * ⚠ "What I don't do" is deliberately absent. The Figma has no such section,
 * and the block that used to live here was written against the old copy
 * document, not the design.
 *
 * ⚠ The three detail titles are ROBOTO CONDENSED at 72.504px, not Poppins. Only
 * the intro h1 `33:287` is Poppins. See the warning in ServiceDetail.astro.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'

import ServiceIntro from '@/components/ServiceIntro.astro'
import ServiceDetail from '@/components/ServiceDetail.astro'

import { META } from '@/content/site'
import { SERVICE_DETAILS } from '@/content/services'

import railAutomation from '@/assets/img/services-rail-automation.jpg'
import railManaged from '@/assets/img/services-rail-managed.jpg'
import rail3d from '@/assets/img/services-rail-3d.jpg'

/**
 * Per-service surface and rail. `rail.x` is a FRAME coordinate; ServiceDetail
 * subtracts the frame's 50px gutter to reach the content box, and derives the
 * text area from whichever side of the rail is left over.
 */
/**
 * ⚠ AUTHORED 2026-08-18 — the rails are 360 wide here, not the Figma's 413.
 *
 * Reported as "the service containers feel too tight". The arithmetic said the
 * same thing: the content box is 1340px, and a 413px rail plus its 40px
 * clearance was taking 453 of it — 34% — leaving 884-887px to hold two columns
 * of ~422px. Narrowing the rail to 360 and cutting `RAIL_GAP` to 24 in
 * `ServiceDetail.astro` returns 69px per row.
 *
 * ⚠ The right-hand rail's x MOVED WITH ITS WIDTH. `33:808` is drawn at x=977
 * w=413, which ends flush on the content box's right edge at 1390. Narrowing it
 * without re-anchoring would have left it floating 53px short of that edge —
 * the one thing about these rails that reads as broken rather than restyled.
 * 1390 - 360 = 1030.
 *
 * The rails are grain-and-gradient textures with no subject to crop (see
 * MANIFEST.md), so `object-fit: cover` absorbs the narrower box with nothing
 * visible lost. Restore 413 / x=977 to go back to the design.
 */
const RAIL_W = 360

const SERVICES = [
  {
    // 33:293 — Creative Automation Systems
    surface: 'raised' as const,
    railImage: railAutomation,
    rail: { node: '33:807', x: 53, w: RAIL_W, edge: 'left' as const },
  },
  {
    // 33:431 — Managed Ad Creative
    surface: 'ink' as const,
    railImage: railManaged,
    rail: { node: '33:808', x: 1390 - RAIL_W, w: RAIL_W, edge: 'right' as const },
  },
  {
    // 33:447 — 3D Product Visuals & CGI Ads
    surface: 'raised' as const,
    railImage: rail3d,
    rail: { node: '33:809', x: 50, w: RAIL_W, edge: 'left' as const },
  },
]

/**
 * Row height in Figma px, shared by all three services so they render at ONE
 * scale — three adjacent sections at three different type sizes would read as
 * a mistake rather than a rhythm.
 *
 * ⚠ MEASURED, NOT DERIVED, and that is a genuine weakness worth knowing about.
 * The old stacked layout could compute its height from Figma y coordinates; a
 * BALANCED two-column layout cannot be known ahead of time, because the height
 * depends on how the copy wraps at the rendered column width. This value came
 * from measuring the built page: at 422px columns the tallest service needs
 * 1463px including the title and its 80px insets, and 1490 leaves that service
 * ~34px of headroom. At the measured 1463 exactly it had **7px**, which is
 * inside the noise of a font-metric or copy change.
 *
 * ⚠ IT CAN GO STALE, AND IT FAILS SILENTLY. `.svc-detail` sets
 * `overflow: hidden`, so if a copy edit pushes a column past this height the
 * overflow is CLIPPED rather than scrolled — a bullet just disappears, and no
 * build gate can see it. After any change to `SERVICE_DETAILS`, re-measure:
 * every `.svc-detail__columns` scrollHeight must stay under its clientHeight.
 */
const ROW_H = 1490
---

{/* AUTHORED 2026-08-18 — footer 33:700 is #242424 in the Figma; requested #161616. */}
<BaseLayout
  title={META.services.title}
  description={META.services.description}
  footerSurface="ink"
>
  <ServiceIntro />

  {
    SERVICE_DETAILS.map((detail, i) => (
      <ServiceDetail
        detail={detail}
        surface={SERVICES[i].surface}
        rail={SERVICES[i].rail}
        railImage={SERVICES[i].railImage}
        rowH={ROW_H}
      />
    ))
  }
</BaseLayout>
