---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Icon from '@/components/Icon.astro'

import { META, PRIMARY_CTA, AVAILABILITY } from '@/content/site'
import { SERVICES, SERVICES_PAGE } from '@/content/services'
import { blankValue } from '@/content/blanks.js'

/**
 * Resolve each service's "what you get" list and price line up front, dropping
 * anything still blank. Blanks #2 (retainer volume), #3 (3D starting price) and
 * #7 (minimum term) all land here — each is omitted, never guessed.
 */
const services = SERVICES.map((service) => ({
  ...service,
  included: service.detail.included
    .map((item) => (item.blank ? blankValue(item.blank as never) : item.text))
    .filter((text): text is string => Boolean(text)),
  priceLine: service.detail.timelineAndPrice
    ? service.detail.timelineAndPrice
    : service.detail.timelineBlank
      ? blankValue(service.detail.timelineBlank as never)
      : null,
}))
---

<BaseLayout title={META.services.title} description={META.services.description}>
  <section class="shell py-section">
    <h1 class="text-h1 text-fg">{SERVICES_PAGE.h1}</h1>
    <p class="measure mt-5 text-lead text-fg-muted">{SERVICES_PAGE.subheadline}</p>
  </section>

  {
    services.map((service, i) => (
      <section
        id={service.slug}
        class:list={[
          'scroll-mt-20 border-t border-line',
          i % 2 === 0 ? 'bg-raised' : '',
        ]}
      >
        <div class="shell grid gap-8 py-section md:grid-cols-[7rem_1fr]">
          <p class="eyebrow reveal">{String(i + 1).padStart(2, '0')}</p>

          <div class="reveal">
            <h2 class="text-h2 text-fg">{service.name}</h2>

            <div class="measure mt-8 space-y-8">
              <div>
                <h3 class="text-h3 text-fg">Who it’s for</h3>
                <p class="mt-3 text-body text-fg-muted">{service.detail.forWhom}</p>
              </div>

              <div>
                <h3 class="text-h3 text-fg">The problem</h3>
                <p class="mt-3 text-body text-fg-muted">{service.detail.problem}</p>
              </div>

              <div>
                <h3 class="text-h3 text-fg">{service.detail.whatIDo.heading}</h3>
                <p class="mt-3 text-body text-fg-muted">{service.detail.whatIDo.body}</p>
              </div>

              {service.included.length > 0 && (
                <div>
                  <h3 class="text-h3 text-fg">What you get</h3>
                  <ul class="mt-4 space-y-3">
                    {service.included.map((text) => (
                      <li class="flex gap-3 text-body text-fg-muted">
                        <Icon name="check" size={18} class="mt-1 shrink-0 text-accent" />
                        <span>{text}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {service.detail.howItWorks && (
                <div>
                  <h3 class="text-h3 text-fg">How it works</h3>
                  <p class="mt-3 text-body text-fg-muted">{service.detail.howItWorks}</p>
                </div>
              )}

              {/* Price line omitted entirely while its figure is unresolved. */}
              {service.priceLine && (
                <div class="surface-inset p-5">
                  <h3 class="text-h3 text-fg">Timeline and price</h3>
                  <p class="mt-2 text-body text-fg-muted">{service.priceLine}</p>
                </div>
              )}

              <div>
                <a href={PRIMARY_CTA.href} class="btn btn-primary">
                  {PRIMARY_CTA.label}
                  <Icon name="arrow-right" size={16} />
                </a>
                <p class="mt-4 text-micro text-fg-quiet">{AVAILABILITY.short}</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  {/* Kept deliberately: the copy notes this is what makes the rest credible. */}
  <section class="border-t border-line">
    <div class="shell grid gap-8 py-section md:grid-cols-[7rem_1fr]">
      <p class="eyebrow reveal">Limits</p>
      <div class="reveal measure">
        <h2 class="text-h2 text-fg">{SERVICES_PAGE.exclusions.heading}</h2>
        <p class="mt-5 text-body text-fg-muted">{SERVICES_PAGE.exclusions.body}</p>
      </div>
    </div>
  </section>

  {/*
    No extra closing CTA here on purpose. The copy document gives each service
    its own "Book a 20-minute fit call", and inventing a fourth heading to fill
    the slot would be writing copy rather than implementing it.
  */}
</BaseLayout>
