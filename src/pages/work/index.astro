---
import { getCollection } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import CaseTeaser from '@/components/CaseTeaser.astro'
import CtaBlock from '@/components/CtaBlock.astro'

import { META } from '@/content/site'
import { PROOF } from '@/content/home'

const cases = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<BaseLayout title={META.work.title} description={META.work.description}>
  <section class="shell py-section">
    {/* Reuses the copy document's own proof headline rather than inventing one. */}
    <h1 class="text-h1 text-fg">{PROOF.h2}</h1>
  </section>

  <section class="border-t border-line bg-raised">
    <div class="shell py-section">
      {
        cases.length > 0 ? (
          <div class="grid gap-5 md:grid-cols-2">
            {cases.map((entry, i) => (
              <CaseTeaser
                title={entry.data.title}
                teaser={entry.data.teaser}
                slug={entry.id}
                service={entry.data.service}
                result={entry.data.result}
                resultBlank={entry.data.resultBlank}
                index={i}
              />
            ))}
          </div>
        ) : (
          <p class="measure text-lead text-fg-subtle">Case studies are being written.</p>
        )
      }
    </div>
  </section>

  <CtaBlock heading="Let’s find out where your bottleneck actually is." />
</BaseLayout>
