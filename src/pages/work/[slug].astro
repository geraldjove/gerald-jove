---
import { getCollection, render } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import Icon from '@/components/Icon.astro'
import CtaBlock from '@/components/CtaBlock.astro'
import { blankValue } from '@/content/blanks.js'

export async function getStaticPaths() {
  const cases = await getCollection('work', ({ data }) => !data.draft)
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)

/**
 * The skeleton from audit §6.3: Context → Problem → What I built → Result →
 * (Testimonial). The last two are omitted whenever their figure or quote is
 * still blank — an empty "Result:" heading would be worse than no section.
 */
const result = entry.data.result ?? (entry.data.resultBlank ? blankValue(entry.data.resultBlank as never) : null)
const testimonial = entry.data.testimonialBlank
  ? blankValue(entry.data.testimonialBlank as never)
  : null

const blocks = [
  { heading: 'Context', body: entry.data.context },
  { heading: 'The problem', body: entry.data.problem },
  { heading: 'What I built', body: entry.data.built },
]
---

<BaseLayout
  title={`${entry.data.title} — Gerald Jove`}
  description={entry.data.teaser}
  ogTitle={entry.data.title}
  ogDescription={entry.data.teaser}
>
  <section class="shell py-section">
    <a href="/work" class="link-arrow text-small">
      <Icon name="arrow-right" size={16} class="rotate-180" />
      All work
    </a>

    <p class="eyebrow mt-8 text-fg-quiet">{entry.data.service}</p>
    <h1 class="mt-4 text-h1 text-fg">{entry.data.title}</h1>
    <p class="measure mt-5 text-lead text-fg-muted">{entry.data.teaser}</p>
  </section>

  <section class="border-t border-line bg-raised">
    <div class="shell py-section">
      <div class="measure space-y-9">
        {
          blocks.map((block) => (
            <div class="reveal">
              <h2 class="text-h3 text-fg">{block.heading}</h2>
              <p class="mt-3 text-body text-fg-muted">{block.body}</p>
            </div>
          ))
        }

        {
          result && (
            <div class="reveal surface-inset p-6">
              <h2 class="text-h3 text-fg">Result</h2>
              <p class="mt-3 text-body text-fg-muted">{result}</p>
            </div>
          )
        }

        {
          testimonial && (
            <figure class="reveal border-l-2 border-accent pl-5">
              <blockquote class="text-lead text-fg-muted">{testimonial}</blockquote>
            </figure>
          )
        }

        {/* Optional long-form body, when the markdown has one. */}
        <div class="prose-body space-y-5">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <CtaBlock heading="Let’s find out where your bottleneck actually is." />
</BaseLayout>
