---
/**
 * Newsletter sign-up — Figma node `33:750`.
 *
 * Extracted from `Footer.astro` on 2026-08-18 because the homepage now carries
 * this block too: `HomeClosing` renders it in the `24:230` panel, which is the
 * right half of the closing frame the design fills with an older footer variant.
 *
 * ⚠ This component owns its INTERNAL type and controls only. **Placement is the
 * host's job** — Astro's scoped styles do not reach in here, so the host wraps
 * it in its own positioned element (`.fx-footer-newsletter`,
 * `.closing__newsletter`) rather than trying to position these nodes directly.
 *
 * ⚠ **Two render modes, and the difference is structural, not cosmetic.**
 *
 *   live  (`NEWSLETTER_ENDPOINT` is a string) — a real `<form method="post">`
 *         with a `type="submit"` button. This is the shipping state.
 *   disabled (`NEWSLETTER_ENDPOINT` is null, `NEWSLETTER_VISIBLE` is true) — a
 *         plain `<div>`; **both controls carry `disabled`**. There is no form
 *         element, so there is no submission, no navigation and no request, and
 *         nothing can be typed in the first place.
 *
 * ⚠ **THE DISABLED STATE IS NOW A SHIPPING STATE, not a preview.** Gerald,
 * 2026-08-18: *"keep the Newsletter but disable it for the time being."* It was
 * introduced two days' worth of decisions earlier as a temporary preview, and
 * AGENTS.md §3 carried a gate saying it must not reach production. **That gate is
 * gone** — see §3, which now checks the property that actually matters (no form,
 * no enabled control) instead of forbidding the state outright.
 *
 * The original rule — “never ship a Submit button that posts nowhere” — was
 * protecting against silently collecting and dropping an address. Emitting no
 * form at all protects against that more strictly than hiding the block did. The
 * second risk, a visitor reading a dead button as a broken site, is what the
 * `disabled` field addresses: nothing invites an address it cannot accept.
 *
 * `data-newsletter="ui-only"` stays on the markup. It is no longer a deploy
 * blocker but it is still the only machine-readable trace of the state — do not
 * remove it, and do not use its absence to mean anything.
 *
 * ⚠ **This instruction was reversed on 2026-08-18 and the old wording is kept so
 * the reversal is visible:** it used to read *"the button keeps its full
 * `.fx-pill` colour when disabled — do not add a greyed-out `:disabled` fill."*
 * That was right for a preview being judged against the design. It is wrong for
 * a state real visitors see, where a pill at full strength reads as pressable.
 * Both controls now dim to 0.55. Reverting is one line in the style block.
 *
 * ⚠ Renders nothing while `NEWSLETTER_VISIBLE` is false. Hosts must check the same
 * constant before drawing their wrapper, or they leave an empty box behind.
 */
import { FOOTER, NEWSLETTER_ENDPOINT, NEWSLETTER_VISIBLE } from '@/content/site'

interface Props {
  /** Distinguishes the two instances' label/field pairing on a page that has both. */
  id?: string
}

const { id = 'newsletter-email' } = Astro.props

/** The single test for “can this actually post”. Never duplicate it inline. */
const live = NEWSLETTER_ENDPOINT !== null

/* Dynamic tag: a `<form>` only exists when there is somewhere for it to go. */
const Wrapper = live ? 'form' : 'div'
const wrapperProps = live
  ? { method: 'post', action: NEWSLETTER_ENDPOINT ?? undefined, 'data-newsletter-form': '' }
  : { 'data-newsletter': 'ui-only' }
---

{
  NEWSLETTER_VISIBLE && (
    <Wrapper class="newsletter" {...wrapperProps}>
      <h2 class="newsletter__heading font-display font-bold">
        <span class="text-accent">{FOOTER.newsletter.lead}</span>
        {FOOTER.newsletter.rest}
      </h2>
      <p class="newsletter__blurb">{FOOTER.newsletter.blurb}</p>
      {/* Honeypot. Off-screen rather than `display: none` — some bots skip
          hidden fields. Named to match what api/subscribe.ts reads. */}
      {live && (
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="newsletter__trap"
        />
      )}

      <div class="newsletter__row">
        <label class="sr-only" for={id}>
          Email address
        </label>
        {/* ⚠ `disabled` in preview mode, added 2026-08-18 when Gerald decided the
            block SHIPS disabled ("keep the Newsletter but disable it for the
            time being"). Until then the field accepted typing while the button
            was dead — which is the exact experience §3's gate existed to keep
            out of production: type an address, press, nothing happens, conclude
            the site is broken. A disabled field cannot be typed into, so the
            visitor learns it is not open before investing anything in it. */}
        <input
          id={id}
          type="email"
          name="email"
          required={live}
          disabled={!live}
          placeholder={FOOTER.newsletter.placeholder}
          class="newsletter__field"
        />
        <button
          type={live ? 'submit' : 'button'}
          disabled={!live}
          class="fx-pill newsletter__submit"
        >
          {FOOTER.newsletter.submit}
        </button>
      </div>

      {/* Runtime states. Hidden at rest and revealed by newsletter.ts; with no
          JS they are never shown, because the native POST navigates to
          /thank-you instead — api/subscribe.ts answers 303 for that path. */}
      {live && (
        <p class="newsletter__note" data-newsletter-success hidden role="status">
          {FOOTER.newsletter.success}
        </p>
      )}
      {live && (
        <p class="newsletter__note newsletter__note--error" data-newsletter-error hidden role="alert">
          {FOOTER.newsletter.error}
        </p>
      )}
    </Wrapper>
  )
}

{/* ⚠ Bundled, never inline — rule 1. Astro emits one shared module even though
    this component renders twice on the homepage (Footer + HomeClosing), and the
    script binds per-form, so two instances do not fight.

    Imported unconditionally rather than behind `live`: an Astro <script> is
    hoisted at build time and is not conditional on runtime props anyway, and the
    script is a no-op when it finds no `[data-newsletter-form]` — which is
    exactly the UI-only preview case. */}
<script>
  import '@/scripts/newsletter.ts'
</script>

<style>
  /* Every length is a Figma node value, px / 16. Node ids in comments. */

  .newsletter__heading {
    font-size: var(--text-fx-40); /* 40.116px — 33:751 */
    line-height: 1.2;
  }

  .newsletter__blurb {
    margin-top: 0.206rem;
    font-size: var(--text-fx-12); /* 12.436px — 33:752 */
  }

  .newsletter__row {
    display: flex;
    gap: 0.588rem; /* 9.363px — 1240.255 → 1250.618 */
    margin-top: 0.68rem;
  }

  .newsletter__field {
    flex: 1 1 auto;
    height: 2.202125rem; /* 35.234px — 33:753 */
    padding-inline: 0.6875rem; /* 11px — placeholder 33:758 sits at x=830 */
    border: 0.06475rem solid var(--color-accent); /* 1.036px */
    border-radius: 0.323813rem; /* 5.181px */
    background-color: var(--color-raised);
    font-size: var(--text-fx-12);
    color: var(--color-fg);
  }

  .newsletter__field::placeholder {
    color: var(--color-fg-placeholder);
  }

  .newsletter__submit {
    width: 8.711377rem; /* 139.382px — 33:755 */
    height: 2.202125rem; /* 35.234px */
    border-radius: 2.051313rem; /* 32.821px */
    font-size: var(--text-fx-12); /* 12.436px — 33:756 */
  }

  /* Disabled state only. The field sets its own background, so the UA cannot
     grey it out; this dims it just enough to read as inactive while the block
     still shows the real design. Both rules go when the endpoint lands. */
  .newsletter__field:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  /* ⚠ REVERSED 2026-08-18, and the earlier comment here said the opposite.
     While this was a preview it kept the full accent fill on purpose, so the
     design could be judged as drawn. Now that the disabled block SHIPS, a pill
     at full strength reads as pressable to a visitor who cannot press it — so it
     dims to the same 0.55 as the field. `.fx-pill` sets its own background, so
     the UA cannot do this for us. One line to revert if Gerald prefers the
     design's full colour and accepts the dead click. */
  .newsletter__submit:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .newsletter__submit:disabled:hover {
    background-color: var(--color-accent);
  }

  /* Off-screen, not `display: none` — a bot that skips hidden inputs still
     fills this one, which is the entire point of a honeypot. */
  .newsletter__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .newsletter__note {
    margin-top: 0.5rem;
    font-size: var(--text-fx-12);
    color: var(--color-fg);
  }

  .newsletter__note--error {
    color: var(--color-fg-muted);
  }
</style>
