---
/**
 * Inline SVG icons, replacing the primeicons webfont (which shipped ~630 KB of
 * eot/svg/ttf/woff/woff2 for a handful of glyphs). These inherit colour and
 * size from the token system and cost no extra request.
 *
 * Functional icons only. Social links are text, per the copy document's footer.
 */
type IconName = 'arrow-right' | 'arrow-up-right' | 'menu' | 'close' | 'check' | 'play' | 'alert'

interface Props {
  name: IconName
  class?: string
  size?: number
}

const { name, class: className = '', size = 20 } = Astro.props

const paths: Record<IconName, string> = {
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  check: 'M4 12.5l5 5L20 6.5',
  play: 'M8 5.5v13l11-6.5z',
  alert: 'M12 8v5M12 16.5v.01M10.3 3.9 2.4 17.5a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z',
}
---

<svg
  class={className || undefined}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} fill={name === 'play' ? 'currentColor' : 'none'} />
</svg>
