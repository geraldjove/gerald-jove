---
/**
 * One service detail section — Figma `33:293`, `33:431` and `33:447`. The three
 * are the same composition mirrored, so this is one component driven by the
 * measured coordinates rather than three near-copies.
 *
 * ⚠⚠ THE TITLE IS ROBOTO CONDENSED, NOT POPPINS. `33:295`, `33:345` and
 * `33:396` are Bold at 72.504px — the same size as the Poppins page h1s, and
 * bigger than anything else on the page. Size does not predict the face here
 * and neither does the element: these are h2s in the workhorse face while the
 * intro h1 `33:287` is the accent face. `--font-sans` IS Roboto Condensed; the
 * token names read backwards on purpose. Do not "fix" this by copying
 * `font-display` off ServiceIntro.astro — AGENTS.md holds the enumeration, and
 * this is the exact node it warns about.
 *
 * Measured fact that still shapes the markup: every block's body sits exactly
 * 93px below its heading, in all twelve blocks across the three sections. So a
 * block is ONE box with the heading and body in flow inside it (42px heading +
 * 51px gap = 93).
 *
 * --- The two-column rework, 2026-08-18 --------------------------------------
 *
 * Each service is ONE 100svh row. The title spans the text area, and the four
 * blocks plus the CTA flow into TWO balanced columns beside the rail — first
 * part on the left, second on the right.
 *
 * This replaces a same-day attempt that split each service into two stacked
 * 100svh screens, which itself replaced the original single 2069/2316px
 * section. `/services` went 4 sections → 7 → back to 4.
 *
 * ⚠ THE FIGMA'S PER-NODE Y COORDINATES ARE GONE, AND THAT IS NOT AN OVERSIGHT.
 * The old layout pinned every block at its own `--b-y` inside an absolutely
 * positioned canvas. Two balanced columns cannot be expressed that way — where
 * a block lands now depends on how the one above it wrapped — so the blocks are
 * in normal flow and the y values were removed rather than left in place
 * looking authoritative. They are recoverable from git history if a 1:1
 * restoration is ever wanted. The x-geometry that survives is the rail's, which
 * still drives which edge the gradient sits on and how wide it is.
 *
 * ⚠ `column-count`, NOT a hardcoded split index. The blocks are wildly uneven —
 * measured at 422px wide, service 2's four blocks are 149 / 401 / 513 / 541px —
 * so the balanced split differs per service (2, 3 and 2 blocks on the left
 * respectively). Letting the browser balance means no per-service magic number
 * to maintain, and a copy edit cannot silently unbalance a column.
 * `break-inside: avoid` is what keeps a block from being torn across the gap.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

import ServiceRuns from './ServiceRuns.astro'
import { SERVICES_CTA, type ServiceDetailSection } from '@/content/services'
import { AVAILABILITY } from '@/content/site'

interface Props {
  detail: ServiceDetailSection
  /** Which of the design's two surfaces this frame is filled with. */
  surface: 'ink' | 'raised'
  /** The gradient rail: its Figma x and width, and the edge it sits on. */
  rail: { node: string; x: number; w: number; edge: 'left' | 'right' }
  railImage: ImageMetadata
  /**
   * Row height in Figma px, shared by all three services so they render at one
   * scale. Computed in `services.astro`; read the note there before changing it.
   */
  rowH: number
}

const { detail, surface, rail, railImage, rowH } = Astro.props

const rem = (px: number) => `${px / 16}rem`

/** The frame's own 50px gutter, subtracted so x is relative to the content box. */
const GUTTER = 50
/** Frame-space right edge of the content box (x=50→1390). */
const CONTENT_RIGHT = 1390
/**
 * Clearance between the rail and the text area. AUTHORED.
 * 40 → 24 on 2026-08-18: see the rail-width note in `services.astro`. Both
 * changes exist to widen the text area, which was reported as feeling tight.
 */
const RAIL_GAP = 24

/**
 * The text area, in content-box space. The rail keeps its drawn x and width, so
 * the columns take whatever is left on the other side of it.
 */
const textX = rail.edge === 'left' ? rail.x + rail.w + RAIL_GAP : GUTTER
const textW =
  rail.edge === 'left' ? CONTENT_RIGHT - textX : rail.x - RAIL_GAP - GUTTER

const rootStyle = [
  // `.fx-frame` reads --fx-h at ≥90rem, and global.css scales the canvas by
  // 100svh/--fx-h from there. No `fx-tall`: at one row per service these fit a
  // viewport readably, which is the point of the rework.
  `--fx-h:${rem(rowH)}`,
  `--d-text-x:${rem(textX - GUTTER)}`,
  `--d-text-w:${rem(textW)}`,
  `--d-rail-x:${rem(rail.x - GUTTER)}`,
  `--d-rail-w:${rem(rail.w)}`,
].join(';')
---

<section
  id={detail.id}
  class:list={['svc-detail', 'fx-frame', `svc-detail--${surface}`, `svc-detail--rail-${rail.edge}`]}
  data-node={detail.node}
  style={rootStyle}
>
  <div class="shell svc-detail__canvas">
    <div class="svc-detail__rail" data-node={rail.node} aria-hidden="true">
      <Image
        src={railImage}
        alt=""
        widths={[64, rail.w]}
        sizes={`(min-width: 90rem) ${rail.w}px, 24px`}
        format="webp"
      />
    </div>

    <div class="svc-detail__col">
      <h2 class="svc-detail__title" data-node={detail.titleNode}>{detail.title}</h2>

      <div class="svc-detail__columns">
        {
          detail.blocks.map((block) => (
            <div class="svc-detail__block">
              <h3 data-node={block.headingNode}>{block.heading}</h3>
              <ServiceRuns runs={block.runs} node={block.bodyNode} />
            </div>
          ))
        }

        <div class="svc-detail__cta">
          <a href={SERVICES_CTA.href} class="fx-pill svc-detail__pill">{SERVICES_CTA.label}</a>
          <p class="svc-detail__availability">{AVAILABILITY.short}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- Authored below 90rem ------------------------------------------------
     The design is a 413px gradient rail beside a text column, which does not
     fit under 1440px. The rail is kept as a narrow full-height edge strip on
     the side the design draws it: the colour signature survives, and the text
     column clears it inside the shell gutter. ONE column here — the two-column
     split is a ≥90rem layout only, and 422px columns do not exist below 1440. */
  /* ⚠ NO `scroll-margin-top` here, deliberately — REMOVED 2026-08-18, and this
     comment is what stops it coming back.

     It used to be `4rem`, to keep a deep-linked title from landing under the
     64px sticky header below 90rem. That reasoning is right and the offset is
     still applied — just once, by `html { scroll-padding-top: 4rem }` in
     global.css, which exists for the same 64px bar and additionally governs
     where scroll-snap rests every section on every page.

     **Both were present, and per spec they SUM.** The target's scroll-margin and
     the scroll container's scroll-padding are independent, so every anchor
     landed 128px low: 64 of sticky header plus 64 of nothing. Measured before
     the fix at 390/768/1280 — section top 128 at all three, when the intent was
     64. Both declarations carried a comment saying “4rem = that 64px exactly”,
     each author believing theirs was the only one.

     The container rule is the one to keep: it is the one snap also reads, and
     it already zeroes itself at ≥90rem where the navbar leaves flow. Re-adding
     an offset here re-creates the double. */
  .svc-detail {
    overflow: hidden;
    padding-block: clamp(3rem, 1.5rem + 6vw, 6rem);
  }

  .svc-detail--ink {
    background-color: var(--color-ink); /* #161616 */
  }

  .svc-detail--raised {
    background-color: var(--color-raised); /* #242424 */
  }

  .svc-detail__canvas {
    position: relative;
  }

  .svc-detail__rail {
    position: absolute;
    inset-block: 0;
    width: clamp(0.5rem, 2.5vw, 1.5rem);
  }

  /* `.shell` is full-bleed below 90rem and insets its content with padding, so
     the strip sits at the canvas edge and the copy already clears it. */
  .svc-detail--rail-left .svc-detail__rail {
    left: 0;
    right: auto;
  }

  .svc-detail--rail-right .svc-detail__rail {
    left: auto;
    right: 0;
  }

  .svc-detail__rail :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 33:295 / 33:345 / 33:396 — Roboto Condensed **Bold** 72.504px, #00aaff.
     See the warning at the top of this file before changing the face. */
  /* ⚠ AUTHORED 2026-08-18 — the colour. `33:295`, `33:345` and `33:396` are
     **#00aaff in the design**; Gerald asked for all three service headlines white.
     Do not “restore fidelity” here.

     The accent is still doing its job one level down: the block headings (`h3`,
     33:298 etc) remain #00aaff, so the section still reads as accent-led — the
     title just stops competing with them. Contrast improves either way: white on
     #242424 measures far above the 4.53:1 floor recorded in AGENTS.md. */
  .svc-detail__title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-fx-72);
    line-height: var(--leading-fx);
    letter-spacing: 0;
    color: var(--color-fg);
    text-wrap: wrap;
  }

  .svc-detail__block {
    margin-top: clamp(2rem, 1rem + 4vw, 3.5rem);
  }

  /* 33:298 etc — Roboto Condensed Bold 36px, #00aaff. */
  .svc-detail__block > h3 {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-fx-36);
    line-height: var(--leading-fx);
    color: var(--color-accent);
    text-wrap: wrap;
  }

  /* ⚠ AUTHORED 2026-08-18 — 3.1875rem (51px) in the Figma, which with the
     heading's own 42px line box put every body node exactly 93px below its
     heading, the offset all twelve blocks share.

     That is the "spaced unevenly" half of the report, and it is a grouping
     problem rather than a size one: at 51px a block's heading sat almost as far
     from its OWN body as blocks sat from each other (56px), so the twelve
     headings and twelve bodies read as twenty-four loose items instead of
     twelve pairs. Pulling the body up to 20px makes the 56px between blocks the
     largest gap in the column, which is what groups them.

     Restore 3.1875rem for a literal 1:1 copy. */
  .svc-detail__block > :global(.svc-runs) {
    margin-top: 1.25rem; /* 20px — was 51px (Figma) */
  }

  .svc-detail__cta {
    margin-top: clamp(2rem, 1rem + 4vw, 3.5rem);
  }

  /* 33:340 / 33:355 / 33:406 with labels 33:341 / 33:356 / 33:407.
     AUTHORED below 90rem: the drawn pill is 35.5px tall, under the 44px touch
     target, so it grows and centres its label there. */
  .svc-detail__pill {
    min-height: 2.75rem;
    padding-inline: 1.75rem;
    font-size: var(--text-fx-16);
  }

  /* AUTHORED — the Figma draws only the button. AGENTS.md rule 5 puts the
     availability line under every call to action regardless. */
  .svc-detail__availability {
    margin-top: 1rem;
    font-family: var(--font-sans);
    font-size: var(--text-fx-17);
    line-height: var(--leading-fx);
    color: var(--color-fg-quiet);
  }

  /* --- Two balanced columns at ≥90rem -------------------------------------- */
  @media (min-width: 90rem) {
    .svc-detail {
      padding-block: 0; /* height comes from --fx-h via .fx-frame */
      /* No `scroll-margin-top: 0` reset needed any more — there is no offset on
         this element to reset. `html { scroll-padding-top }` already zeroes
         itself at this width, because the navbar is `position: absolute` here,
         leaves flow, and scrolls away with nothing to land under. */
    }

    .svc-detail__canvas {
      height: 100%;
    }

    /* Written with the same two-class specificity as the authored edge-strip
       rules above, so these actually win rather than losing to them. */
    .svc-detail--rail-left .svc-detail__rail,
    .svc-detail--rail-right .svc-detail__rail {
      left: var(--d-rail-x);
      right: auto;
      width: var(--d-rail-w);
    }

    /* The text area: whatever the rail leaves. A flex column so the title takes
       its natural height and the balanced columns absorb the rest. */
    .svc-detail__col {
      position: absolute;
      left: var(--d-text-x);
      top: 5rem; /* 80 — AUTHORED inset, the Figma's own titleY varied 84–127 */
      width: var(--d-text-w);
      height: calc(100% - 10rem);
      display: flex;
      flex-direction: column;
    }

    .svc-detail__title {
      font-size: 4.5315rem; /* 72.504 */

      /* 85px, read from the node: `33:295`, `33:345` and `33:396` are each a
         single 72.504px line in an 85px box (get_metadata). There is no
         --leading-fx-72 token because 72.504 is the only size at this value.

         ⚠ The 85 does NOT prove which leading model Figma used —
         round(72.504 × 1.171875) = 85 and round(72.504 × 7/6) = 85 both land on
         it, so this node cannot discriminate. It is pinned to the measured box
         either way, which is what a 1:1 copy needs. */
      line-height: 5.3125rem;
    }

    /* ⚠ `min-height: 0` is load-bearing. A flex item defaults to
       `min-height: auto`, which refuses to shrink below its content — the
       column box would grow past the row and `overflow: hidden` on the section
       would eat whatever fell off the bottom, silently. */
    .svc-detail__columns {
      flex: 1;
      min-height: 0;
      margin-top: 2.5rem; /* 40 — AUTHORED */
      column-count: 2;
      /* 40 → 48 on 2026-08-18. The columns gained ~35px each from the narrower
         rail; spending 8 of that on the gutter keeps the two columns reading as
         two rather than as one wrapped block. */
      column-gap: 3rem; /* 48 — AUTHORED */
      column-fill: balance;
    }

    /* ⚠ Without this a block is torn across the column gap: its heading ends up
       at the foot of the left column and its body at the head of the right. */
    .svc-detail__block,
    .svc-detail__cta {
      break-inside: avoid;
      margin-top: 0;
    }

    /* The blocks are spaced from each other rather than from the column top, so
       neither column opens with a leading gap. */
    /* 56 → 72 on 2026-08-18. The heading-to-body gap above dropped 31px per
       block, which both tightened each pair AND left the column short of the
       row. Spending part of that on the gap BETWEEN blocks does two jobs at
       once: it puts the largest gap in the column where the grouping boundary
       is, and it takes back some of the height the column otherwise loses.
       ⚠ Do not raise this much further — the columns are a fixed-height
       multicol and anything past the row height is clipped by
       `overflow: hidden`, silently. Check the last availability line is still
       visible on all three services after changing it. */
    .svc-detail__block + .svc-detail__block,
    .svc-detail__block + .svc-detail__cta {
      margin-top: 4.5rem; /* 72 — AUTHORED, was 56 */
    }

    .svc-detail__block > h3 {
      font-size: 2.25rem; /* 36 */
    }

    .svc-detail__pill {
      justify-content: flex-start;
      width: 16.1433rem; /* 258.293 */
      height: 2.2204rem; /* 35.527 */
      min-height: 0;
      padding-inline: 1.7937rem 0; /* label inset 28.699 */
      border-radius: 3.8013rem; /* 60.821 */
      font-size: 1.08025rem; /* 17.284 */
    }
  }
</style>
