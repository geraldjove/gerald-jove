---
/**
 * What I Do — Figma node `33:121` (1440 x 1024).
 *
 * ⚠ `33:130` and `33:167` are bulleted lists collapsed into a single Figma text
 * node each; they are rebuilt as real <ul>/<li>.
 *
 * ⚠ `33:171` — the Tools card — is NOT bulleted in the design. It is two
 * labelled prose runs ("For creative work:" / "For development:"). It is marked
 * up as a real list of those two groups, with markers switched off, because
 * adding bullets would show marks the design does not draw. That is the only
 * way to satisfy both "rebuild as a real list" and 1:1.
 */
import { ABOUT } from '@/content/about'

const { heading, cards, tools } = ABOUT.capabilities
---

<section class="about-capabilities fx-fit">
  <div class="about-capabilities__inner">
    <h2 class="about-capabilities__heading">
      {
        heading.map((run) => (
          <span class:list={[run.accent && 'about-capabilities__accent']}>{run.text}</span>
        ))
      }
    </h2>

    <div class="about-capabilities__grid">
      {
        cards.map((card) => (
          <article class="about-card">
            <h3 class="about-card__label">{card.label}</h3>
            <ul class="about-card__list">
              {card.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }

      <article class="about-card">
        <h3 class="about-card__label">{tools.label}</h3>
        <ul class="about-card__groups">
          {
            tools.groups.map((group) => (
              <li>
                <p class="about-card__group-label">{group.label}</p>
                <p>{group.body}</p>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  /* --- Authored below 90rem ------------------------------------------------ */
  .about-capabilities {
    background-color: var(--color-ink);
    padding-block: var(--a-pad-block);
  }

  .about-capabilities__inner {
    width: 100%;
    max-width: calc(var(--fx-content) + 2 * var(--spacing-gutter));
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  /* 33:123 — Roboto Condensed Bold 64px, line-height 68 (not `normal`) */
  .about-capabilities__heading {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-fx-64);
    line-height: 1.0625;
    color: var(--color-fg);
    text-align: center;
    text-wrap: wrap;
  }

  .about-capabilities__accent {
    color: var(--color-accent);
  }

  .about-capabilities__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 3rem; /* 33:222 — 48 between cards */
    margin-top: 2.0625rem;
  }

  /* 33:124 / 33:165 / 33:169 */
  .about-card {
    box-sizing: border-box;
    background-color: var(--color-ink);
    border: 0.100438rem solid var(--color-accent); /* 1.607 */
    border-radius: 0.73675rem; /* 11.788 */
    /* 24 and 26 from the card's OUTER edge, less the 1.607 border. */
    padding: 1.399563rem 1.399563rem 1.399563rem 1.524563rem;
  }

  /* 33:129 / 33:166 / 33:170 — Roboto Condensed Bold 30px */
  .about-card__label {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-fx-30);
    line-height: var(--leading-fx);
    color: var(--color-accent);
    text-wrap: wrap;
  }

  /* 33:130 / 33:167 — Roboto Condensed Regular 18px */
  .about-card__list {
    margin-top: 0.625rem;
    padding-left: 1.6875rem; /* 27 — the marker indent Figma draws */
    list-style: disc;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-fx-18);
    line-height: var(--leading-fx);
    color: var(--color-fg);
  }

  /* 33:171 — two labelled groups, no markers. */
  .about-card__groups {
    --size: var(--text-fx-18);
    --lh: calc(var(--size) * var(--leading-fx));
    margin-top: 0.625rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--size);
    line-height: var(--lh);
    color: var(--color-fg);
  }

  .about-card__groups > li + li,
  .about-card__groups > li > * + * {
    margin-top: var(--lh); /* one blank 18px line */
  }

  .about-card__group-label {
    font-weight: 700;
  }

  .about-card__groups p {
    text-wrap: wrap;
  }

  /* --- Figma-exact at >=90rem ---------------------------------------------- */
  @media (min-width: 90rem) {
    .about-capabilities {
      /* --fx-h feeds the 100svh viewport fit in global.css (`.fx-fit`). */
      --fx-h: 64rem; /* 33:121 — 1024 */
      height: var(--fx-h);
      padding-block: 0;
    }

    /* ⚠ Was 58.875rem (942, the Figma group box). Widened to the full 1440
       design canvas on 2026-08-18 so the three cards can sit at the HOMEPAGE's
       own x positions — see the grid rule below. The heading is unaffected: it
       is 576 wide and `margin-inline: auto`, so it was centred on the frame at
       942 and is still centred on the frame at 1440.

       `min(90rem, 100%)` rather than a bare 90rem, for the reason `.fx-canvas`
       in global.css spells out — a media query counts the scrollbar gutter and
       layout does not, so a bare 1440 hangs 7.5px off both edges in that band. */
    .about-capabilities__inner {
      width: min(90rem, 100%);
      max-width: none;
      padding-inline: 0;
      padding-top: 18.1875rem; /* 33:123 — y=291 */
    }

    .about-capabilities__heading {
      width: 36rem; /* 33:123 — 576 */
      height: 3.875rem; /* 33:123 — 62 */
      margin-inline: auto;
      font-size: 4rem;
      line-height: 4.25rem; /* 68 */
    }

    /* --- Homepage card geometry, adopted 2026-08-18 ------------------------
       Requested: these containers should be the same size as the homepage's
       "Three ways I can help" cards. Both sections are 1440-wide frames with
       exactly three cards, so the cards take the homepage's own widths AND its
       x positions — `.card:nth-child(n)` in HomeServices.astro is the source
       for every number here. Copy any change there to here.

         card 1   x=54   w=415      card 2   x=491  w=416
         card 3   x=928  w=457      all      h=611

       ⚠ AUTHORED, not from the Figma. `33:121` draws three 282×348 cards in a
       942px group; this is 415/416/457×611 across the full frame. It is a
       deliberate departure to match the homepage, and the widths are unequal
       because the HOMEPAGE's are — they are not a mistake to be "evened up".

       `space-between` with the two explicit paddings reproduces x=54 and the
       1385 right edge; the leftover 43px splits into the design's ~21.5px
       gutters. That is why `column-gap` is 0 — the gap is the leftover, not a
       value of its own.

       Vertical: the grid still starts at y=386 (291 heading + 62 + 33), so the
       cards run 386→997 inside the 1024 frame, clearing the bottom by 27px. */
    .about-capabilities__grid {
      box-sizing: border-box;
      grid-template-columns: 25.9375rem 26rem 28.5625rem; /* 415 / 416 / 457 */
      column-gap: 0;
      justify-content: space-between;
      padding-inline: 3.375rem 3.4375rem; /* 54 left; 1440-1385=55 right */
      margin-top: 2.0625rem; /* 291 + 62 + 33 = 386, node 33:222 y */
    }

    /* ⚠ NO `height` HERE, DELIBERATELY — the cards hug their content.
       Changed 2026-08-18, one revision after they took the homepage's full
       611px: these three lists are far shorter than the homepage cards, which
       carry a lede, body copy, a price, a timeline and a CTA, so a matched
       height left each card two-thirds empty.

       The WIDTHS still match the homepage exactly; only the height is content
       driven. Grid `align-items` is left at its `stretch` default on purpose,
       so all three equalise to the tallest card and their bottom edges stay on
       one line — `align-self: start` would let each find its own height and the
       row would end ragged, which reads as a bug rather than a choice. */
    .about-card {
      /* 1.5rem to match the homepage card's inset. The Figma's own 24/26 inset
         was measured for a 282px card and reads tight in a 415px one. */
      padding: 1.5rem;
    }

    /* Leading is absolute here, not a ratio — Figma rounds it to a whole pixel
       per size. See about.astro. */
    .about-card__label {
      height: 2.1875rem; /* 33:129 — 35 */
      font-size: 1.875rem; /* 30 */
      line-height: var(--leading-fx-30); /* 35 */
    }

    .about-card__list {
      font-size: 1.125rem; /* 33:130 — 18 */
      line-height: var(--leading-fx-18); /* 21 */
    }

    .about-card__groups {
      --size: 1.125rem; /* 33:171 — 18 */
      --lh: var(--leading-fx-18); /* 21 */
    }
  }
</style>
