---
import { FOOTER } from '@/content/site'
---

<footer class="border-t border-line bg-ink">
  <div class="shell py-section-sm">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-h3 text-fg">Gerald Jove</p>
        <p class="mt-3 max-w-xs text-small text-fg-subtle">{FOOTER.tagline}</p>
      </div>

      <nav aria-label="Footer">
        <p class="eyebrow">Site</p>
        <ul class="mt-4 space-y-2.5">
          {
            FOOTER.columns.map((link) => (
              <li>
                <a href={link.href} class="text-small text-fg-subtle transition-colors hover:text-fg">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="eyebrow">Elsewhere</p>
        <ul class="mt-4 space-y-2.5">
          {
            FOOTER.social.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel="me noopener"
                  target="_blank"
                  class="text-small text-fg-subtle transition-colors hover:text-fg"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="hairline-top mt-12 pt-6 text-micro text-fg-quiet">{FOOTER.legal}</p>
  </div>
</footer>
