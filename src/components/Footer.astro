---
/**
 * Site footer — a 1:1 rebuild of the Figma `Footer` frame.
 *
 * Source nodes: 33:730 (About), 33:700 (Services), 33:760 (Contact). All three
 * are byte-identical in geometry, so this is one component. The homepage CTA
 * frame carries an older variant with Facebook / Instagram / YouTube icons —
 * not used; no URLs exist for those accounts.
 *
 * Frame: 1440 × 359, background #242424, content box x=50→1390 (1340px), which
 * is exactly `.shell` at ≥90rem. Unlike the navbar, the footer IS on the
 * content grid.
 *
 * Vertical budget at ≥90rem, which is why the offsets below look arbitrary:
 *   38 top + 80 tagline + 17 + 150.777 columns + 18.223 + 17 copyright + 38 = 359
 *
 * The newsletter block (33:750) lives in `Newsletter.astro` since 2026-08-18,
 * because the homepage closing frame carries one too. It is drawn whenever
 * NEWSLETTER_VISIBLE is true — which since 2026-08-18 includes the backend-less
 * UI preview, see site.ts. It sits in the right half at x=819 and carries none of
 * the footer's height, so omitting it leaves the geometry above intact and the
 * footer is 359px tall either way.
 *
 * ⚠ AUTHORED 2026-08-18 — the `surface` prop. Footer nodes 33:700 (Services)
 * and 33:760 (Contact) are #242424 in the design, byte-identical to 33:730
 * (About), which is why this is one component. Gerald asked for #161616 on
 * Services and Contact only. `raised` is the default and remains the Figma
 * value; `ink` is the deviation. Same prop shape as ServiceDetail's `surface`.
 *
 * ⚠ Two faithfully reproduced oddities, both from the design rather than from
 * this code, both flagged in the handover report:
 *   - Each column heading is indented 12.2px relative to its own list.
 *   - The list items are real bulleted lists; the bullet sits at the column
 *     origin and the label 26.15px inboard of it.
 */
import Newsletter from './Newsletter.astro'
import { FOOTER, NEWSLETTER_VISIBLE } from '@/content/site'

interface Props {
  /** Which of the design's two surfaces this footer is filled with. */
  surface?: 'ink' | 'raised'
}

const { surface = 'raised' } = Astro.props

const isExternal = (href: string) => href.startsWith('http')
---

<footer class:list={['fx-footer', `fx-footer--${surface}`]}>
  <div class="shell fx-footer-inner">
    <p class="fx-footer-tagline font-bold">
      {FOOTER.tagline.lead}<span class="text-accent">{FOOTER.tagline.accent}</span>
    </p>

    <div class="fx-footer-cols">
      {
        FOOTER.columns.map((col) => (
          <div class="fx-footer-col">
            <h2 class="fx-footer-col-heading font-bold">{col.heading}</h2>
            <ul class="fx-footer-list">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel={isExternal(link.href) ? 'me noopener' : undefined}
                    target={isExternal(link.href) ? '_blank' : undefined}
                    class="transition-colors hover:text-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      /* Newsletter 33:750. The wrapper is gated on the SAME constant as the block
         itself, so a hidden newsletter never leaves an empty positioned box behind.
         Whether the block can actually post is Newsletter.astro's business, not
         this file's — do not re-test the endpoint here. */
      NEWSLETTER_VISIBLE && (
        <div class="fx-footer-newsletter">
          <Newsletter id="footer-newsletter-email" />
        </div>
      )
    }

    <p class="fx-footer-legal font-bold">{FOOTER.legal}</p>
  </div>
</footer>

<style>
  /* Every length below is a Figma node value, px / 16. Node ids in comments.
     Below 90rem there is no design; that branch is authored. */

  .fx-footer-inner {
    padding-block: 2.375rem; /* 38px — content box starts at y=38 (33:731) */
  }

  /* 33:732 — Roboto Condensed Bold 34px, 655 × 80, two lines at 40px. */
  .fx-footer-tagline {
    max-width: 40.9375rem; /* 655px */
    font-size: var(--text-fx-34);
    line-height: 1.176; /* 40 / 34 — the design's own two-line box */
  }

  /* 33:733 — three columns at x=50 / 245 / 352 within the content box, so the
     first two are given the full 195px and 107px steps rather than their text
     widths. Pinning the step keeps columns two and three in place even when a
     rendered label is a pixel or two wider than Figma measured it. */
  .fx-footer-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 1.375rem 0; /* 22px row gap when wrapped */
    margin-top: 1.0625rem; /* 17px — tagline ends 118, columns start 135 */
  }

  .fx-footer-col:nth-child(1) {
    width: 12.1875rem; /* 195px — 173 content + 22 gap (33:734) */
  }

  .fx-footer-col:nth-child(2) {
    width: 6.6875rem; /* 107px — 85 content + 22 gap (33:739) */
  }

  /* 33:735 / 33:740 / 33:745 — Roboto Condensed Bold 17.435px.
     ⚠ The 12.2px indent is the design's, not a mistake in this file: the
     heading sits 12.2px right of its own list. Reported, not corrected. */
  .fx-footer-col-heading {
    margin-inline-start: 0.762787rem; /* 12.2046px */
    font-size: var(--text-fx-17);
    line-height: 1.0625rem; /* 17px — the node's own height */
    color: var(--color-fg);
    text-wrap: nowrap;
  }

  /* 33:736–33:749 — Roboto Condensed Regular 17.435px, real bulleted lists.
     Row pitch is 33.127px: a 17px line box plus a 16.127px step. */
  .fx-footer-list {
    margin-top: 1.062375rem; /* 16.998px — heading ends 152, first item 168.998 */
    padding-inline-start: 1.634531rem; /* 26.1525px — label offset from the bullet */
    list-style: disc;
    font-size: var(--text-fx-17);
  }

  .fx-footer-list li {
    line-height: 1.0625rem; /* 17px */
  }

  .fx-footer-list li + li {
    margin-top: 1.007938rem; /* 16.127px */
  }

  /* 33:757 — centred on the frame (549 + 342/2 = 720), Bold 17.435px. */
  .fx-footer-legal {
    margin-top: 1.138916rem; /* 18.223px — columns end 285.777, legal starts 304 */
    font-size: var(--text-fx-17);
    line-height: 1.0625rem; /* 17px */
    text-align: center;
  }

  /* The two surfaces. `raised` (#242424) is the Figma value for all three
     footer nodes; `ink` is the AUTHORED 2026-08-18 request for Services and
     Contact. Tokens, not hex literals — `--color-ink` IS #161616. */
  .fx-footer--raised {
    background-color: var(--color-raised);
  }

  .fx-footer--ink {
    background-color: var(--color-ink);
  }

  /* ⚠ `end`, not `start`. The footer is 359px and is NOT a full-screen section,
     so snapping its TOP to the viewport top would park it under a screen that
     is two-thirds empty. Aligning its END to the snapport end makes the natural
     resting place the bottom of the document, which is where a footer belongs.
     Without any alignment it is skipped entirely under `scroll-snap-type:
     mandatory` — added with the 100svh sections on 2026-08-18. */
  .fx-footer {
    scroll-snap-align: end;
  }

  /* ⚠ Below 90rem the newsletter is in FLOW, and until 2026-08-18 it was hidden
     entirely, so this gap had never been drawn: the block sat 0px under the link
     columns and collided with the last list item at every width from 320 to 1439.

     18.223px is the footer's own number, not a chosen one — it is the gap the
     column block already owns below itself in the 359px budget
     (38 + 80 tagline + 17 + 150.777 columns + **18.223** + 17 copyright + 38),
     and it is already what separates the newsletter from the copyright here. Using
     it above as well makes the block symmetric in the mobile stack. */
  .fx-footer-newsletter {
    margin-block-start: 1.138938rem; /* 18.223px */
  }

  @media (min-width: 90rem) {
    /* Exact frame: 359px tall, and the column block holds its Figma height so
       the copyright lands on y=304 whatever the lists render at. */
    .fx-footer {
      height: 22.4375rem; /* 359px */
    }

    .fx-footer-inner {
      position: relative;
    }

    .fx-footer-tagline {
      height: 5rem; /* 80px — 33:732 */
    }

    .fx-footer-cols {
      height: 9.423584rem; /* 150.77734375px — 33:733 */
      flex-wrap: nowrap;
    }

    /* ⚠ AUTHORED 2026-08-18 — the vertical position, on Gerald's instruction:
       “properly center vertically … aligned to the left side content”.

       The Figma puts 33:750 at y=40, level with the tagline's top, which left the
       block hugging the footer's top edge with 239px of dead space under it while
       the left column ran the full height. Centred instead.

       The two readings of the instruction converge exactly, which is why this is
       one rule and not a compromise: the left content spans y=38 (tagline top) to
       y=321 (copyright bottom), centre **179.5**; the frame is 359 tall, centre
       **179.5**. Centring in the frame IS centring against the left column.

       `top: 50%` + `translateY(-50%)` rather than a computed offset, because the
       block's height is type-dependent (118.3px today) and a hardcoded top would
       silently decentre the moment the blurb wraps or the type scale moves.
       `.fx-footer-inner` is the containing block and its padding box is the full
       359px, so the 50% resolves against the frame, not the content box. */
    .fx-footer-newsletter {
      position: absolute;
      left: 48.0625rem; /* 769px into the content box — x=819 (33:750) */
      top: 50%;
      transform: translateY(-50%);
      width: 35.6875rem; /* 571px */

      /* ⚠ Must be reset. `margin-block-start` on an absolutely positioned box is
         ADDED to `top`, so leaving the flow gap in place pushes the block 18.2px
         below the centre this rule just computed. */
      margin-block-start: 0;
    }
  }
</style>
