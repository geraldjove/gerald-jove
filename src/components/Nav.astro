---
import Icon from './Icon.astro'
import { NAV_LINKS, NAV_CTA } from '@/content/site'

const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/85 backdrop-blur-md">
  <nav class="shell flex h-16 items-center justify-between gap-4" aria-label="Primary">
    <a
      href="/"
      class="font-display text-[1.0625rem] font-extrabold tracking-tight text-fg transition-colors hover:text-accent-hi"
    >
      Gerald Jove
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'text-small font-medium transition-colors',
                isCurrent(link.href) ? 'text-fg' : 'text-fg-subtle hover:text-fg',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href={NAV_CTA.href} class="btn btn-primary hidden md:inline-flex">{NAV_CTA.label}</a>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Toggle navigation menu"
        class="grid h-10 w-10 place-items-center rounded-lg border border-line text-fg transition-colors hover:border-line-strong md:hidden"
      >
        <span data-icon="menu"><Icon name="menu" /></span>
        <span data-icon="close" class="hidden"><Icon name="close" /></span>
      </button>
    </div>
  </nav>

  <div id="nav-panel" data-nav-panel hidden class="border-t border-line md:hidden">
    <ul class="shell flex flex-col py-2">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'block py-3 text-body font-medium transition-colors',
                isCurrent(link.href) ? 'text-fg' : 'text-fg-subtle hover:text-fg',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="py-3">
        <a href={NAV_CTA.href} class="btn btn-primary w-full">{NAV_CTA.label}</a>
      </li>
    </ul>
  </div>
</header>

<script>
  import '@/scripts/nav.ts'
</script>
