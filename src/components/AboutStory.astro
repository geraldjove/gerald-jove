---
/**
 * My Story — Figma node `33:116` (1440 x 1985).
 *
 * ⚠ `33:119` is ONE Figma text node holding the whole story, with each sentence
 * on its own line and a blank line between. It is rebuilt as one <p> per
 * sentence — thirty of them, then the larger accent closing line — split only
 * at those existing blank lines. The blank line is reproduced as a margin of
 * exactly one 24px line box (24 x 7/6 = 28), so the vertical rhythm matches the
 * single node it came from.
 *
 * The copy, including the date in `story.body[23]`, is transcribed verbatim.
 * See the warning in `src/content/about.ts`.
 */
import { ABOUT } from '@/content/about'
---

<section class="about-story fx-fit fx-tall" data-story-track>
  <div class="about-story__viewport">
    <div class="about-story__inner">
      <h2 class="about-story__heading">
        {
          ABOUT.story.heading.map((run) => (
            <span class:list={[run.accent && 'about-story__accent']}>{run.text}</span>
          ))
        }
      </h2>

      <div class="about-story__stage" data-story-stage>
        <div class="about-story__body" data-story-column>
          {ABOUT.story.body.map((line) => <p>{line}</p>)}
          <p class="about-story__close">{ABOUT.story.close}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{/*
  Bundled, never inline — Astro compiles this to `<script type="module" src=…>`,
  which is what the `script-src 'self'` CSP allows. Kept in this component rather
  than BaseLayout so Motion is only bundled into /about, and Home, Services and
  Contact keep their ~3 KB of JS.
*/}
<script>
  import '@/scripts/story-pin.ts'
</script>

<style>
  /* --- Authored below 90rem ------------------------------------------------ */
  .about-story {
    background-color: var(--color-raised);
    padding-block: var(--a-pad-block);
  }

  .about-story__inner {
    width: 100%;
    max-width: calc(var(--fx-content) + 2 * var(--spacing-gutter));
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    text-align: center;
  }

  /* 33:117 — Roboto Condensed Bold 64px */
  .about-story__heading {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-fx-64);
    line-height: var(--leading-fx);
    color: var(--color-fg);
    text-wrap: wrap;
  }

  .about-story__accent {
    color: var(--color-accent);
  }

  /* 33:119 */
  .about-story__body {
    --size: var(--text-fx-24);
    --lh: calc(var(--size) * var(--leading-fx));
    margin-top: 2.125rem;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--size);
    line-height: var(--lh);
    color: var(--color-fg);
  }

  .about-story__body > p {
    text-wrap: wrap;
  }

  /* The blank line between sentences, measured on the 24px run so the larger
     closing line does not inherit a larger gap than the design draws. */
  .about-story__body > * + * {
    margin-top: var(--lh);
  }

  /* Sets its own leading — it must not inherit the 24px line box above it. */
  .about-story__close {
    font-weight: 700;
    font-size: var(--text-fx-36);
    line-height: var(--leading-fx);
    color: var(--color-accent);
  }

  /* --- Figma-exact at >=90rem ---------------------------------------------- */
  @media (min-width: 90rem) {
    .about-story {
      /* ⚠ `fx-tall` on the section opts this OUT of the 100svh viewport fit,
         deliberately. At 1985px against a ~1015px viewport the fit would scale
         the canvas to ~0.51 and render 18px body copy at ~9px — unreadable.
         This section stays taller than one screen and snaps to its own top
         edge instead. Same call as the three Services detail frames. */
      --fx-h: 124.0625rem; /* 33:116 — 1985 */
      height: var(--fx-h);
      padding-block: 0;
    }

    .about-story__inner {
      width: 83.9375rem; /* 33:120 — 1343, centred on the frame */
      max-width: none;
      padding-inline: 0;
      padding-top: 4.875rem; /* 33:117 — y=78 */
    }

    /* Leading is absolute here, not a ratio: Figma rounds it to a whole pixel
       per size, so 64px is 75 and NOT 64 x 7/6 = 74.667. See about.astro. */
    .about-story__heading {
      height: 4.6875rem; /* 33:117 — 75 */
      font-size: 4rem;
      line-height: var(--leading-fx-64); /* 75 */
    }

    .about-story__body {
      --size: 1.5rem; /* 33:119 — 24 */
      --lh: var(--leading-fx-24); /* 28 */
      margin-top: 2.125rem; /* 78 + 75 + 34 = 187, node 33:119 y */
    }

    .about-story__close {
      font-size: 2.25rem; /* 36 */
      line-height: var(--leading-fx-36); /* 42 */
    }
  }

  /* --- Scroll-pinned reading panel, added 2026-08-18 ------------------------
     Requested: the section should pin, fade the story through on scroll, and
     release to the next section once the story is done.

     ⚠ EVERY RULE HERE IS BEHIND `[data-pinned]`, WHICH ONLY `story-pin.ts`
     SETS. With no JS, or with reduced motion, none of it applies and the
     section stays an ordinary column with all thirty-one lines readable —
     AGENTS.md forbids content that depends on JS to appear. Do not promote any
     of this into the default rules.

     ⚠ These sit AFTER the 90rem block on purpose. `[data-pinned]` adds
     attribute specificity so it beats the plain `.about-story` height in there
     regardless, but keeping the source order honest means the override is
     visible to whoever reads the file top to bottom.

     ⚠ `position: sticky` DIES inside a transformed ancestor, and every other
     section on this site is transformed by the viewport fit in global.css. This
     one works only because it carries `fx-tall`, which opts out of that
     transform. If `fx-tall` is ever removed from this section, the pin breaks
     silently — it will simply stop sticking, with no error. */
  .about-story[data-pinned] {
    position: relative;
    height: calc(var(--story-screens, 3) * 100svh);
    padding-block: 0;
    /* No `scroll-snap-align` — the page has no scroll snap since 2026-08-18.
       This used to be an explicit `none`, opting the tall story track OUT of
       being a single snap target. Nothing to opt out of now. */
  }

  .about-story[data-pinned] .about-story__viewport {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100svh;
    overflow: hidden;
  }

  .about-story[data-pinned] .about-story__inner {
    display: flex;
    flex-direction: column;
    max-height: 100%;
    padding-block: clamp(2rem, 6vh, 5rem);
  }

  /* `min-height: 0` is load-bearing: a flex item defaults to `min-height: auto`,
     which refuses to shrink below its content, so the stage would grow to the
     full column height and there would be nothing to scroll. */
  .about-story[data-pinned] .about-story__stage {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    /* The design's 34px heading-to-body gap, moved onto the stage. It cannot
       stay on the column: the column's own top margin counts toward its
       scrollHeight, so it would offset the travel `story-pin.ts` measures. And
       without a gap the copy fades through hard against the heading's
       descenders, which reads as a collision rather than a mask. */
    margin-top: 2.125rem;
    /* The fade itself — copy dissolves in at the top edge and out at the bottom
       as it travels. Done with a mask rather than per-paragraph animations:
       thirty scroll-linked opacity tweens would cost real frame time to
       reproduce an effect the compositor gives for free here.

       ⚠ `--story-fade` is set by `story-pin.ts`, in px, from the stage's real
       height, and the SAME value pads the column top and bottom. The two must
       agree: the padding is what keeps the first and last lines out of the
       fade, so they can be read in full at each end of the travel. The 16%
       fallback only applies for the instant before the script measures. */
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 var(--story-fade, 16%),
      #000 calc(100% - var(--story-fade, 16%)),
      transparent 100%
    );
  }

  .about-story[data-pinned] .about-story__body {
    margin-top: 0;
    will-change: transform;
  }

  /* ⚠ The snap-marker “beats” were REMOVED 2026-08-18 with the page's scroll
     snap. One 1px x 100svh marker per screen was created at runtime and existed
     for a single purpose: `scroll-snap-type: y mandatory` had no snap position
     anywhere inside this tall track, so the scroller flung the reader from the
     section's start straight to the next section and the story was skipped end
     to end. No snap, no need for them. The container element, its CSS, and the
     creation loop in `story-pin.ts` all went together.

     Worth keeping from that episode, because it will bite again on any runtime
     element: the rule needed `:global()`. Astro scopes component CSS by adding a
     `data-astro-cid-*` attribute, and it can only add it to elements present in
     the TEMPLATE — a scoped selector matches nothing a script created, and fails
     silently rather than erroring. */
</style>
