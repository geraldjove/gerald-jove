---
import Icon from './Icon.astro'
import { blankValue } from '@/content/blanks.js'

interface Props {
  title: string
  teaser: string
  slug: string
  service: string
  result?: string | null
  resultBlank?: string | null
  index?: number
}

const { title, teaser, slug, service, result, resultBlank, index = 0 } = Astro.props

/**
 * The hard number, or nothing. Blank #1 is the highest-value sentence on the
 * site and the copy document is explicit that it must not be invented — so when
 * it is missing the entire Result block disappears rather than rendering an
 * orphan label.
 */
const resolvedResult = result ?? (resultBlank ? blankValue(resultBlank as never) : null)
---

<article class="surface reveal p-6 sm:p-8" style={`--reveal-delay:${index * 90}ms`}>
  <p class="eyebrow text-fg-quiet">{service}</p>
  <h3 class="mt-4 text-h3 text-fg">{title}</h3>
  <p class="mt-4 text-small text-fg-subtle">{teaser}</p>

  {
    resolvedResult && (
      <p class="mt-6 border-l-2 border-accent pl-4 text-small text-fg-muted">
        <span class="font-semibold text-fg">Result: </span>
        {resolvedResult}
      </p>
    )
  }

  <a href={`/work/${slug}`} class="link-arrow mt-6 text-small">
    Read the full story
    <Icon name="arrow-right" size={16} />
  </a>
</article>
