---
/**
 * "What this looks like in real life" — Figma node `8:28`, 1440 x 1173,
 * fill #161616. Two alternating rows, no slider and no JavaScript.
 *
 * Case one is text-only on purpose: the visual the Figma draws beside it
 * (node 30:12, wrapping 30:2) is a permanently excluded node — see the
 * excluded-node table in AGENTS.md. Case two keeps its own image, 32:30.
 */
import { Image } from 'astro:assets'

import HomeLines from './HomeLines.astro'
import { PROOF } from '@/content/home'

import proof3d from '@/assets/img/home-proof-product-cutaway.jpg'

const [caseOne, caseTwo] = PROOF.cases
---

<section class="fx-frame proof" style="--fx-h: 73.3125rem" data-node="8:28">
  <div class="proof__canvas">
    <p class="proof__eyebrow" data-node="22:72">{PROOF.eyebrow}</p>

    <h2 class="proof__h2" data-node="22:73">
      <HomeLines lines={PROOF.h2.lines} />
    </h2>

    <article class="proof__case proof__case--one" data-node={caseOne.node}>
      <h3 class="proof__title" data-node="22:76">{caseOne.title}</h3>
      <p class="proof__text" data-node="22:74">{caseOne.body}</p>
    </article>

    <article class="proof__case proof__case--two" data-node={caseTwo.node}>
      <h3 class="proof__title" data-node="22:85">{caseTwo.title}</h3>
      <p class="proof__text" data-node="22:84">{caseTwo.body}</p>
    </article>

    <figure class="proof__figure" data-node="32:30">
      <Image
        src={proof3d}
        alt={caseTwo.image.alt}
        widths={[560, 790, 1579]}
        sizes="(min-width: 90rem) 49.5rem, 92vw"
        format="webp"
        quality={80}
        class="proof__img"
      />
    </figure>
  </div>
</section>

<style>
  .proof {
    background-color: var(--color-ink); /* 8:28 fill #161616 */
  }

  .proof__canvas {
    position: relative;
    padding: 5rem var(--spacing-gutter);
  }

  .proof__eyebrow {
    margin: 0;
    font-family: var(--font-sans); /* Roboto Condensed */
    font-weight: 700;
    font-size: var(--home-text-13); /* 22:72 13.792px */
    line-height: var(--leading-fx);
    color: var(--color-accent);
    text-align: center;
  }

  .proof__h2 {
    margin: 0.375rem 0 0;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-fx-49); /* 22:73 49.04px */
    line-height: var(--leading-fx);
    color: var(--color-fg);
    text-align: center;
    text-wrap: wrap; /* global.css sets `balance` on h1-h6 */
  }

  .proof__case {
    margin-top: 3rem;
  }

  .proof__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--home-text-36); /* 22:76 / 22:85 36.78px */
    line-height: var(--leading-fx);
    color: var(--color-accent);
    text-wrap: wrap;
  }

  .proof__text {
    margin: 0.75rem 0 0;
    max-width: 32.1594rem; /* 22:74 / 22:84 are 514.55px wide */
    font-family: var(--font-sans);
    font-size: var(--text-fx-18); /* 18px */
    line-height: var(--leading-fx);
    color: var(--color-fg);
    text-wrap: wrap; /* global.css sets `pretty` */
  }

  .proof__figure {
    margin: 1.5rem 0 0;
  }

  /* The export is the mask group 32:26, so the rounded crop is already baked in
     against #161616. The accent outline around it is a separate node (32:27)
     and is drawn here. */
  .proof__img {
    display: block;
    width: 100%;
    height: auto;
    border: 0.0958rem solid var(--color-accent); /* 32:27 stroke 1.532px */
    border-radius: 0.9578rem; /* 32:27 radius 15.325px */
  }

  /* --- The design, exactly ------------------------------------------------ */
  @media (min-width: 90rem) {
    .proof__canvas {
      position: absolute;
      /* `inset: 0` + a definite width + `margin-inline: auto` centres it.
         `min()` not a bare 90rem: a media query counts the scrollbar gutter
         and layout does not, so on a 1440px window this box would be 1440
         wide inside 1425 of layout and hang 7.5px off both edges. Same
         reasoning as `.fx-canvas` in global.css. */
      inset: 0;
      width: min(var(--fx-frame), 100%);
      margin-inline: auto;
      padding: 0;
    }

    .proof__eyebrow,
    .proof__h2 {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      margin: 0;
      width: max-content;
    }

    .proof__eyebrow {
      top: 5.5rem; /* 22:72 y=88, box centre x=719.7 */
      line-height: var(--home-leading-13); /* 16px */
    }

    .proof__h2 {
      top: 6.5057rem; /* 22:73 y=104.091, box centre x=720.1 */
      line-height: var(--leading-fx-49); /* 57px */
    }

    .proof__case {
      position: absolute;
      margin-top: 0;
    }

    .proof__title,
    .proof__text {
      position: absolute;
      margin: 0;
      max-width: none;
    }

    .proof__title {
      line-height: var(--home-leading-36); /* 43px — 22:76 / 22:85 are 36.78px */
    }

    .proof__text {
      line-height: var(--leading-fx-18); /* 21px */
    }

    /* Case one — text on the right, no image. 22:80 */
    .proof__case--one {
      left: 54.4375rem; /* 22:76 x=871 */
      top: 18.875rem; /* y=302 */
      width: 32.4375rem; /* 519 */
    }

    .proof__case--one .proof__title {
      left: 0;
      top: 0;
      width: 32.4375rem; /* 519 */
    }

    .proof__case--one .proof__text {
      left: 0.2781rem; /* 22:74 x=875.45 against the case's 871 */
      top: 7.0623rem; /* y=414.997 against 302 */
      width: 32.1594rem; /* 514.55 */
    }

    /* Case two — text on the left, image on the right. 22:83 */
    .proof__case--two {
      left: 3.125rem; /* 22:85 x=50 */
      top: 48.125rem; /* y=770 */
      width: 32.4375rem;
    }

    .proof__case--two .proof__title {
      left: 0;
      top: 0;
      width: 32.0625rem; /* 513 */
    }

    .proof__case--two .proof__text {
      left: 0.2956rem; /* 22:84 x=54.729 against 50 */
      top: 3.5623rem; /* y=826.997 against 770 */
      width: 32.1594rem; /* 514.55 */
    }

    .proof__figure {
      position: absolute;
      left: 37.5625rem; /* 32:30 x=601 */
      top: 42.875rem; /* y=686 */
      width: 49.3312rem; /* 789.299 */
      height: 25rem; /* 400 */
      margin: 0;
    }

    .proof__img {
      height: 100%;
      object-fit: cover;
    }
  }
</style>
