---
/**
 * "What this looks like in real life" — Figma node `8:28`, 1440 x 1173,
 * fill #161616. Two alternating rows, no slider and no JavaScript.
 *
 * Both rows carry an image: case one `30:12`, case two `32:30`. Case one's was
 * withheld until 2026-08-18 on the belief it was client-engagement material;
 * it is Gerald's own generated artwork, so the exclusion is lifted. The file is
 * capped at a resolution that leaves the code in its right-hand half illegible
 * — see AGENTS.md §4 before ever replacing it with a sharper export.
 *
 * ⚠ Still not a before/after slider. The split is baked into the raster, so
 * there is nothing to slide between and no JavaScript here.
 */
import { Image } from 'astro:assets'

import HomeLines from './HomeLines.astro'
import { PROOF } from '@/content/home'

import proofAutomation from '@/assets/img/home-proof-automation-split.jpg'
import proof3d from '@/assets/img/home-proof-product-cutaway.jpg'

const [caseOne, caseTwo] = PROOF.cases
---

<section class="fx-frame proof" style="--fx-h: 73.3125rem" data-node="8:28">
  <div class="proof__canvas">
    <p class="proof__eyebrow" data-node="22:72">{PROOF.eyebrow}</p>

    <h2 class="proof__h2" data-node="22:73">
      <HomeLines lines={PROOF.h2.lines} />
    </h2>

    <article class="proof__case proof__case--one" data-node={caseOne.node}>
      <h3 class="proof__title" data-node="22:76">{caseOne.title}</h3>
      <p class="proof__text" data-node="22:74">{caseOne.body}</p>
    </article>

    <figure class="proof__figure proof__figure--one" data-node="30:12">
      <Image
        src={proofAutomation}
        alt={caseOne.image.alt}
        widths={[395, 790]}
        sizes="(min-width: 90rem) 49.5rem, 92vw"
        format="webp"
        quality={80}
        class="proof__img"
      />

      {/* 30:18 / 30:19 / 30:17 sit *over* the raster as separate Figma nodes. */}
      <figcaption class="proof__overlay">
        <span class="proof__label proof__label--before" data-node="30:18"
          >{caseOne.image.labels.before}</span
        >
        <span class="proof__label proof__label--after" data-node="30:19"
          >{caseOne.image.labels.after}</span
        >

        {
          /* 30:17. Exact path data from the Figma export, which draws the arrow
             pointing UP in a 93.1776 x 127 box; the design rotates it to point
             right. `translate(127 0) rotate(90)` is that rotation, which maps
             (x,y) -> (127 - y, x) and lands the apex at (127, 46.59) — the
             right edge, vertically centred. Inline rather than a committed
             .svg for the reason Icon.astro gives: it costs no extra request. */
        }
        <svg
          class="proof__arrow"
          viewBox="0 0 127 93.1776"
          fill="var(--color-accent)"
          aria-hidden="true"
          focusable="false"
          data-node="30:17"
        >
          <g transform="translate(127 0) rotate(90)">
            <path d="M46.5889 0L86.9359 69.8832H6.24179L46.5889 0Z"></path>
            <rect x="28.1855" y="46.7546" width="36.8068" height="80.2454"></rect>
          </g>
        </svg>
      </figcaption>
    </figure>

    <article class="proof__case proof__case--two" data-node={caseTwo.node}>
      <h3 class="proof__title" data-node="22:85">{caseTwo.title}</h3>
      <p class="proof__text" data-node="22:84">{caseTwo.body}</p>
    </article>

    <figure class="proof__figure proof__figure--two" data-node="32:30">
      <Image
        src={proof3d}
        alt={caseTwo.image.alt}
        widths={[560, 790, 1579]}
        sizes="(min-width: 90rem) 49.5rem, 92vw"
        format="webp"
        quality={80}
        class="proof__img"
      />
    </figure>
  </div>
</section>

<style>
  .proof {
    background-color: var(--color-ink); /* 8:28 fill #161616 */
  }

  .proof__canvas {
    position: relative;
    padding: 5rem var(--spacing-gutter);
  }

  /* ⚠ AUTHORED 2026-08-18 — requested: "Real Work" follows the font sizing of
     "The Problem". The Figma disagrees: 22:72 is 13.792px and 22:30 is 18px,
     and both were copied correctly. This deliberately overrides 22:72 to match
     `.problem__eyebrow`, so the two eyebrows read as one component. Keep the
     two in step — if `.problem__eyebrow` changes size, this follows it. */
  .proof__eyebrow {
    margin: 0;
    font-family: var(--font-sans); /* Roboto Condensed */
    font-weight: 700;
    font-size: var(--text-fx-18); /* was --home-text-13 (22:72, 13.792px) */
    line-height: var(--leading-fx);
    color: var(--color-accent);
    text-align: center;
  }

  .proof__h2 {
    margin: 0.375rem 0 0;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-fx-49); /* 22:73 49.04px */
    line-height: var(--leading-fx);
    color: var(--color-fg);
    text-align: center;
    text-wrap: wrap; /* global.css sets `balance` on h1-h6 */
  }

  .proof__case {
    margin-top: 3rem;
  }

  .proof__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--home-text-36); /* 22:76 / 22:85 36.78px */
    line-height: var(--leading-fx);
    color: var(--color-accent);
    text-wrap: wrap;
  }

  .proof__text {
    margin: 0.75rem 0 0;
    max-width: 32.1594rem; /* 22:74 / 22:84 are 514.55px wide */
    font-family: var(--font-sans);
    font-size: var(--text-fx-18); /* 18px */
    line-height: var(--leading-fx);
    color: var(--color-fg);
    text-wrap: wrap; /* global.css sets `pretty` */
  }

  .proof__figure {
    position: relative; /* anchors case one's overlay; --two has nothing to anchor */
    margin: 1.5rem 0 0;
  }

  /* --- Case one's overlay, nodes 30:18 / 30:19 / 30:17 --------------------
     Positioned in PERCENT, not rem, and deliberately so. These are absolute
     children of a box that is 789.3 x 400 only at >=90rem and fluid below it;
     the rem offsets the rest of this file uses would send them off the image
     on a phone. Each percentage below is the Figma offset over the Figma box,
     so the design width is still exact.

     The trailing label anchors to the RIGHT and BOTTOM edges rather than
     left/top. Same position at 1440, but a `left:` of 69.8% would push a
     nowrap label past the right edge of a 375px-wide figure. */
  .proof__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .proof__label {
    position: absolute;
    font-family: var(--font-sans); /* Roboto Condensed */
    font-weight: 700;
    font-size: var(--text-fx-24); /* 30:18 / 30:19 are 24px */
    line-height: var(--leading-fx-24); /* 28px — matches both nodes' 28px box */
    color: var(--color-accent);
    white-space: nowrap;
    /* 30:18 / 30:19 both carry this. It is not decoration: accent-on-photo is
       the one place in this design where the text sits on unknown pixels. */
    text-shadow: 0 0.25rem 0.25rem #000;
  }

  .proof__label--before {
    left: 1.9%; /* 30:18 x=65 against the box's x=50 -> 15/789.3 */
    top: 2.5%; /* y=234 against y=224 -> 10/400 */
  }

  .proof__label--after {
    right: 2.7%; /* 30:19 ends x=818; box ends 839.3 -> 21.3/789.3 */
    bottom: 2.25%; /* ends y=615; box ends 624 -> 9/400 */
  }

  /* ⚠ AUTHORED 2026-08-18 — requested: "the blue arrow is not centered at the
     image". It was not, horizontally: the Figma draws 30:17 at x=508 in a box
     starting at x=50, i.e. left 58.03% + width 16.09%, which centres it on
     66.1%. Vertically it was already centred (38.25% + 23.3% -> 49.9%), so only
     the horizontal offset changes. The design value is kept in the comment
     because this is a deviation from a correct 1:1 copy, not a bug fix. */
  .proof__arrow {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 38.25%; /* y=377 against 224 -> 153/400 */
    width: 16.09%; /* 127/789.3 */
    height: auto;
    aspect-ratio: 127 / 93.1776;
  }

  /* The export is the mask group 32:26, so the rounded crop is already baked in
     against #161616. The accent outline around it is a separate node (32:27)
     and is drawn here. */
  .proof__img {
    display: block;
    width: 100%;
    height: auto;
    border: 0.0958rem solid var(--color-accent); /* 32:27 stroke 1.532px */
    border-radius: 0.9578rem; /* 32:27 radius 15.325px */
  }

  /* --- The design, exactly ------------------------------------------------ */
  @media (min-width: 90rem) {
    .proof__canvas {
      position: absolute;
      /* `inset: 0` + a definite width + `margin-inline: auto` centres it.
         `min()` not a bare 90rem: a media query counts the scrollbar gutter
         and layout does not, so on a 1440px window this box would be 1440
         wide inside 1425 of layout and hang 7.5px off both edges. Same
         reasoning as `.fx-canvas` in global.css. */
      inset: 0;
      width: min(var(--fx-frame), 100%);
      margin-inline: auto;
      padding: 0;
    }

    .proof__eyebrow,
    .proof__h2 {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      margin: 0;
      width: max-content;
    }

    /* ⚠ AUTHORED 2026-08-18, and the offset moved WITH the size — the two are
       one change. The design puts 22:72 at y=88 with a 16px line box, ending
       16.09px clear of the h2 at y=104.091. At 18px the line box is 21px
       (18 x --leading-fx), which would have overrun the heading by ~5px.

       The HEADING keeps its Figma y exactly; the eyebrow is raised so its
       taller line still ends where the 16px one did: 104.091 - 21 = 83.091px.
       Growing the eyebrow upward is what leaves every other node on this frame
       untouched. */
    .proof__eyebrow {
      top: 5.1932rem; /* 83.091px — was 5.5rem (22:72 y=88) */
      line-height: var(--leading-fx-18); /* 21px — matches .problem__eyebrow */
    }

    .proof__h2 {
      top: 6.5057rem; /* 22:73 y=104.091, box centre x=720.1 */
      line-height: var(--leading-fx-49); /* 57px */
    }

    .proof__case {
      position: absolute;
      margin-top: 0;
    }

    .proof__title,
    .proof__text {
      position: absolute;
      margin: 0;
      max-width: none;
    }

    .proof__title {
      line-height: var(--home-leading-36); /* 43px — 22:76 / 22:85 are 36.78px */
    }

    .proof__text {
      line-height: var(--leading-fx-18); /* 21px */
    }

    /* Case one — text on the right, no image. 22:80 */
    .proof__case--one {
      left: 54.4375rem; /* 22:76 x=871 */
      top: 18.875rem; /* y=302 */
      width: 32.4375rem; /* 519 */
    }

    .proof__case--one .proof__title {
      left: 0;
      top: 0;
      width: 32.4375rem; /* 519 */
    }

    .proof__case--one .proof__text {
      left: 0.2781rem; /* 22:74 x=875.45 against the case's 871 */
      top: 7.0623rem; /* y=414.997 against 302 */
      width: 32.1594rem; /* 514.55 */
    }

    /* Case two — text on the left, image on the right. 22:83 */
    .proof__case--two {
      left: 3.125rem; /* 22:85 x=50 */
      top: 48.125rem; /* y=770 */
      width: 32.4375rem;
    }

    .proof__case--two .proof__title {
      left: 0;
      top: 0;
      width: 32.0625rem; /* 513 */
    }

    .proof__case--two .proof__text {
      left: 0.2956rem; /* 22:84 x=54.729 against 50 */
      top: 3.5623rem; /* y=826.997 against 770 */
      width: 32.1594rem; /* 514.55 */
    }

    /* Both figures are the same 789.299 x 400 box; only the corner differs.
       Case one sits left and high, mirroring case two right and low. */
    .proof__figure {
      position: absolute;
      width: 49.3312rem; /* 789.299 */
      height: 25rem; /* 400 */
      margin: 0;
    }

    .proof__figure--one {
      left: 3.125rem; /* 30:12 x=50 */
      top: 14rem; /* y=224 */
    }

    .proof__figure--two {
      left: 37.5625rem; /* 32:30 x=601 */
      top: 42.875rem; /* y=686 */
    }

    .proof__img {
      height: 100%;
      object-fit: cover;
    }
  }
</style>
