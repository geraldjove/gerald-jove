---
import '@/styles/global.css'
import Nav from '@/components/Nav.astro'
import Footer from '@/components/Footer.astro'
import { SITE_URL } from '@/content/site'
import { blankValue } from '@/content/blanks.js'

interface Props {
  title: string
  description: string
  ogTitle?: string
  ogDescription?: string
  /** Set on /thank-you and 404 — pages with no business being indexed. */
  noindex?: boolean
  /**
   * Set `false` on the homepage only. The closing frame (8:32) draws its own
   * footer in the design, and since 2026-08-18 it carries the newsletter block,
   * so the shared footer under it would be a second one.
   *
   * ⚠ Turning this off also removes the three link columns (33:734 / 33:739 /
   * 33:744) and the copyright line (33:757) from that page. Nothing else on the
   * site renders them.
   */
  footer?: boolean
  /** Which surface the shared footer is filled with. See Footer.astro. */
  footerSurface?: 'ink' | 'raised'
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  noindex = false,
  footer = true,
  footerSurface = 'raised',
} = Astro.props

/**
 * Real per-route canonical. The old SPA had none at all, and a single static
 * canonical would have been worse than none — it would have labelled every
 * route as the homepage.
 */
const path = Astro.url.pathname.replace(/\/+$/, '')
const canonical = `${SITE_URL}${path}`
const socialTitle = ogTitle ?? title
const socialDescription = ogDescription ?? description

/** Blank #6. While null the og:image tag is omitted rather than pointed at a placeholder. */
const ogImage = blankValue('ogImage')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/logo.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gerald Jove" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, SITE_URL).href} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, SITE_URL).href} />}

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer surface={footerSurface} />}

    <script>
      import '@/scripts/reveal.ts'
    </script>
  </body>
</html>
